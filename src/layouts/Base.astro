---
import '../styles/global.css';
import '@fontsource/iosevka/latin-400.css';
import '@fontsource/iosevka/latin-700.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { config } from '../config';

type SeoProps = Parameters<typeof SEO>[0];
interface Props extends SeoProps {}
const props = Astro.props;
const gc = config.analytics.goatcounter;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <SEO {...props} />
    <slot name="head" />
    {gc.enabled && <script is:inline data-goatcounter={`https://${gc.code}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js"></script>}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
