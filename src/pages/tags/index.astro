---
import Base from '../../layouts/Base.astro';
import { getPosts, tagCounts } from '../../lib/posts';

const tags = [...tagCounts(await getPosts())].sort((a, b) => b[1].count - a[1].count);
---
<Base title="Tags" description="Browse posts by topic." breadcrumbs={[{ name: 'Tags', path: '/tags/' }]}>
  <h1>Tags</h1>
  <ul class="tag-cloud">
    {tags.map(([slug, t]) => <li><a href={`/tags/${slug}/`}>#{t.label} ({t.count})</a></li>)}
  </ul>
</Base>
